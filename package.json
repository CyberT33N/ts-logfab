{
  "name": "ts-logfab",
  "version": "1.0.0",
  "type": "module",
  "description": "This package provides sleek and powerful TypeScript decorators that integrate seamlessly with Pino, the super-fast logger. Decorate your classes, methods, or parameters to auto-log inputs, outputs, and execution details — beautifully formatted and developer-friendly. ",
  "private": false,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "lint": "pnpm eslint --config eslint.config.mjs .",
    "example": "tsx --watch --tsconfig tsconfig.base.json examples/app.ts",
    "test": "vitest",
    "test:only:linux": "bash test-only.sh",
    "test:only:windows": "powershell -ExecutionPolicy Bypass -File test-only.ps1",
    "test:watch": "vitest --watch",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "test:regression": "vitest run --project regression",
    "test:update-snapshots": "vitest --update",
    "prepare": "husky"
  },
  "keywords": [
    "pino",
    "typescript",
    "decorator",
    "logger"
  ],
  "author": "CyberT33N",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.10.0",
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/lodash": "^4.17.17",
    "@types/node": "^22.15.17",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.26.0",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.4",
    "type-fest": "^4.41.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "zod": "^3.24.4"
  },
  "dependencies": {
    "@sindresorhus/is": "^7.0.2",
    "@types/cli-progress": "^3.11.6",
    "ansi-styles": "^6.2.1",
    "chalk": "^5.4.1",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.5",
    "color-convert": "^3.1.0",
    "colorette": "^2.0.20",
    "dotenv": "^16.5.0",
    "gradient-string": "^3.0.0",
    "lodash": "^4.17.21",
    "pino": "^9.7.0",
    "pretty-bytes": "^7.0.0",
    "pretty-ms": "^9.2.0",
    "safe-stable-stringify": "^2.5.0",
    "strip-ansi": "^7.1.0",
    "supports-color": "^10.0.0",
    "terminal-link": "^4.0.0",
    "zod-package-json": "^1.2.0"
  }
}
