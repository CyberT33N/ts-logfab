{
  "name": "ts-logfab",
  "version": "1.0.0",
  "private": false,
  "description": "This package provides sleek and powerful TypeScript decorators that integrate seamlessly with Pino, the super-fast logger. Decorate your classes, methods, or parameters to auto-log inputs, outputs, and execution details — beautifully formatted and developer-friendly. ",
  "keywords": [
    "pino",
    "typescript",
    "decorator",
    "logger"
  ],
  "license": "MIT",
  "author": "CyberT33N",
  "type": "module",
  "files": [
    "examples",
    "dist",
    "src",
    "!**/*.test.*",
    "!**/*.spec.*"
  ],
  "scripts": {
    "example:alternative": "tsx --tsconfig tsconfig.base.json examples/app-alternative-enhanced-decorator.ts",
    "example:enhanced": "tsx --tsconfig tsconfig.base.json examples/app-enhanced-decorators.ts",
    "example:enterprise": "tsx --tsconfig tsconfig.base.json examples/app-enterprise-config.ts",
    "example:main": "tsx --tsconfig tsconfig.base.json examples/app-main-decorators.ts",
    "example:performance": "tsx --tsconfig tsconfig.base.json examples/app-manual-performance.ts",
    "lint": "pnpm eslint --config eslint.config.mjs .",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "test": "vitest",
    "test:integration": "vitest run --project integration",
    "test:only:linux": "bash test-only.sh",
    "test:only:windows": "powershell -ExecutionPolicy Bypass -File test-only.ps1",
    "test:regression": "vitest run --project regression",
    "test:unit": "vitest run --project unit",
    "test:update-snapshots": "vitest --update",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@sindresorhus/is": "~7.0.2",
    "@types/cli-progress": "~3.11.6",
    "@typescript-eslint/utils": "^8.39.0",
    "ansi-styles": "~6.2.1",
    "chalk": "~5.4.1",
    "cli-progress": "~3.12.0",
    "cli-table3": "~0.6.5",
    "color-convert": "~3.1.0",
    "colorette": "~2.0.20",
    "dotenv": "~16.5.0",
    "gradient-string": "~3.0.0",
    "lodash": "~4.17.21",
    "pino": "~9.7.0",
    "pretty-bytes": "~7.0.0",
    "pretty-ms": "~9.2.0",
    "safe-stable-stringify": "~2.5.0",
    "strip-ansi": "~7.1.0",
    "supports-color": "~10.0.0",
    "terminal-link": "~4.0.0",
    "zod-package-json": "~1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "~9.26.0",
    "@stylistic/eslint-plugin": "~5.2.2",
    "@types/lodash": "~4.17.17",
    "@types/node": "~22.15.17",
    "@vitest/coverage-v8": "~3.2.4",
    "eslint": "~9.31.0",
    "eslint-import-resolver-node": "~0.3.9",
    "eslint-import-resolver-typescript": "~4.3.4",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-jsonc": "~2.20.1",
    "eslint-plugin-jsx-a11y": "~6.10.2",
    "eslint-plugin-n": "~17.21.3",
    "eslint-plugin-no-secrets": "~2.2.1",
    "eslint-plugin-package-json": "~0.48.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-prefer-arrow": "~1.2.3",
    "eslint-plugin-prefer-arrow-functions": "^3.6.2",
    "eslint-plugin-promise": "~7.2.1",
    "eslint-plugin-react": "~7.37.5",
    "eslint-plugin-react-hooks": "~5.2.0",
    "eslint-plugin-react-perf": "^3.3.3",
    "eslint-plugin-regexp": "^2.9.1",
    "eslint-plugin-security": "~3.0.1",
    "eslint-plugin-sonarjs": "~3.0.4",
    "eslint-plugin-tsdoc": "~0.4.0",
    "eslint-plugin-typescript-sort-keys": "^3.3.0",
    "eslint-plugin-unicorn": "~60.0.0",
    "eslint-plugin-unused-imports": "~4.1.4",
    "eslint-plugin-vitest": "^0.5.4",
    "eslint-plugin-xss": "~0.1.12",
    "husky": "~9.1.7",
    "jiti": "^2.5.1",
    "pino-pretty": "~13.0.0",
    "tsx": "~4.19.4",
    "type-fest": "~4.41.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "~8.32.0",
    "vite-tsconfig-paths": "~5.1.4",
    "vitest": "~3.2.4",
    "zod": "~3.24.4"
  },
  "packageManager": "pnpm@8.10.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
